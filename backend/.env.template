# ========================================
# Cricket Auction Engine - Configuration
# ========================================

# Server Configuration
# --------------------
PORT=5000                              # Backend server port
NODE_ENV=development                   # Environment: development, production, test

# Database Configuration
# ----------------------
MONGODB_URI=mongodb://localhost:27017/cricket-auction  

TIMER_DURATION=20                      
INITIAL_BUDGET=110                    
BASE_PRICE=5                          
MAX_SQUAD_SIZE=11                     
MAX_CAPTAINS=20                      

ADMIN_PASSWORD=admin123               
JWT_SECRET=your-secret-key-here       
SESSION_SECRET=your-session-secret    

MAX_FILE_SIZE=10485760                
UPLOAD_DIR=./uploads                 

CORS_ORIGIN=*                         
# WebSocket Configuration
# -----------------------
WS_PING_INTERVAL=25000                # WebSocket ping interval (ms)
WS_PING_TIMEOUT=60000                 # WebSocket ping timeout (ms)

# Logging
# -------
LOG_LEVEL=info                        # Logging level: error, warn, info, debug
LOG_FILE=./logs/app.log              # Log file path

# Email Configuration (Optional - for future features)
# ---------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@cricketauction.com

# SMS Configuration (Optional - for future features)
# ------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Redis Configuration (Optional - for caching)
# -------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Production Optimization
# -----------------------
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://...         # Use MongoDB Atlas
# CORS_ORIGIN=https://yourdomain.com    # Restrict CORS
# ADMIN_PASSWORD=SecurePassword123!     # Use strong password
# LOG_LEVEL=warn                        # Reduce logging
# SESSION_SECRET=random-64-char-string  # Use crypto-generated secret

# ========================================
# IMPORTANT SECURITY NOTES:
# ========================================
# 1. Never commit .env to version control
# 2. Use strong passwords in production
# 3. Generate random secrets for JWT/Session
# 4. Restrict CORS to specific domains
# 5. Use HTTPS/WSS in production
# 6. Enable rate limiting
# 7. Keep dependencies updated
# ========================================
